  "thermal": {
    "ambient_c": 60.0,
    "parts": {
      "U2": {
        "detail": "this board is two layers and the figure was obtained on a four-layer JEDEC board, which is why what follows is a margin against that path rather than a junction temperature for this one",
        "dissipation_w": 0.42284159458296033,
        "documents": [
          "tcan1042_ti"
        ],
        "junction_max_c": 150.0,
        "theta_ja": {
          "conditions": "D (SOIC) package, high-K board",
          "document": "tcan1042_ti",
          "measured_on": {
            "copper_layers": 4,
            "note": "high-K board under natural convection, obtained by simulation in the JESD51-2a environment",
            "standard": "JESD51-7"
          },
          "regime": "steady_state",
          "source": "components/parameters.json: TCAN1042HGVDR.thermal.rthja_c_per_w",
          "units": "C/W",
          "value": 105.8
        },
        "why": "dominant-state supply current on both rails, taken as continuous; the share that leaves through the bus load is not subtracted"
      },
      "U3": {
        "detail": "this board is two layers and the figure was obtained on a four-layer JEDEC board, which is why what follows is a margin against that path rather than a junction temperature for this one",
        "dissipation_w": 0.1998677760769223,
        "documents": [
          "mp2459_mps"
        ],
        "junction_max_c": 125.0,
        "theta_ja": {
          "conditions": "measured on JESD51-7, 4-layer PCB",
          "document": "mp2459_mps",
          "measured_on": {
            "copper_layers": 4,
            "note": "the four-layer construction the figure's own stated condition names",
            "standard": "JESD51-7"
          },
          "regime": "steady_state",
          "source": "components/parameters.json: MP2459GJ-Z.thermal.rthja_c_per_w",
          "units": "C/W",
          "value": 220.0
        },
        "why": "the whole converter loss at the assumed 75 percent efficiency, charged to the controller rather than split with the inductor and the catch diode"
      },
      "U4": {
        "detail": "the datasheet states one figure per package and no test board, so there is nothing to compare this board's copper against",
        "dissipation_w": 0.06762304255574958,
        "documents": [
          "ht75rxx_holtek"
        ],
        "junction_max_c": 150.0,
        "theta_ja": {
          "document": "ht75rxx_holtek",
          "regime": "steady_state",
          "source": "components/parameters.json: HT75R33-1A.thermal.rthja_c_per_w",
          "units": "C/W",
          "value": 200.0
        },
        "why": "the drop from the intermediate rail to the logic rail at the logic rail's bounded maximum load"
      }
    },
    "why": "the three parts with a steady-state junction-to-ambient figure in their datasheets. The low-side switches and the blocking FET are not here: their datasheets state a junction-to-ambient resistance measured over ten seconds on a 1 inch2 2 oz board, which is not a continuous path, and this board will not derate a continuously conducting channel against a transient figure. Their dissipation stays judged against the package rating, and the register still records that a thermal analysis is owed for them. The passives are judged individually against their own power ratings."
  },
